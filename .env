# Twitter OAuth Configuration
# Get these from: https://developer.twitter.com/en/portal/dashboard

# Your API Key (Consumer Key) from Twitter Developer Console
TWITTER_CONSUMER_KEY=qeDDjx2mu3KgemuN0e4orMDf2
VITE_TWITTER_CONSUMER_KEY=qeDDjx2mu3KgemuN0e4orMDf2

# Your API Secret (Consumer Secret) from Twitter Developer Console
# IMPORTANT: Keep this secret! Never commit to public repositories
TWITTER_CONSUMER_SECRET=your_consumer_secret_here

# Callback URL - Must match ngrok URL and Twitter Console settings
# Format: https://your-ngrok-url.ngrok-free.dev/auth/twitter/callback
TWITTER_CALLBACK_URL=https://unafraid-defection-bobble.ngrok-free.dev/auth/twitter/callback
VITE_TWITTER_CALLBACK_URL=https://unafraid-defection-bobble.ngrok-free.dev/auth/twitter/callback

# Random secret for HMAC token generation
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_SECRET=your_random_secret_here

# OAuth Server Configuration
OAUTH_SERVER_PORT=3001
